# Administrator credentials are consumed only by workflow-db-migrate.
FLYWAY_URL=jdbc:postgresql://synkro-db:5432/synkro?connectTimeout=5&socketTimeout=60
FLYWAY_USER=REPLACE_WITH_INSTANCE_ADMINISTRATOR
FLYWAY_PASSWORD=REPLACE_WITH_RUNNER_ONLY_SECRET
WORKFLOW_DATABASE_URL=jdbc:postgresql://synkro-db:5432/synkro
WORKFLOW_APP_PASSWORD_PATH=/absolute/protected/workflow-app-password
JWT_PUBLIC_KEY_PATH=/absolute/protected/auth-public.pem
WORKFLOW_SERVICE_TOKEN=REPLACE_WITH_AUTH_ISSUED_SERVICE_TOKEN
PLATFORM_NETWORK=platform
WORKFLOW_EXECUTORS=4
WORKFLOW_QUEUE=64
WORKFLOW_RESPONSE_TIMEOUT_MS=1000
# Direct Java startup accepts JWT_PUBLIC_KEY_FILE, WORKFLOW_APP_PASSWORD_FILE
# and SERVICE_TOKEN_FILE (or SERVICE_TOKEN). Private signing keys never belong here.
